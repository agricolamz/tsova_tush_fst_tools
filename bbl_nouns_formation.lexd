Nouns_Obl[o_stem] [o:] [>:>] Inflection[-diff_for_o_u,-lat]
Nouns_Obl[u_stem] [u:] [>:>] Inflection[lat]
Nouns_Obl[o_stem] [o:] [>:>] Inflection[lat]


