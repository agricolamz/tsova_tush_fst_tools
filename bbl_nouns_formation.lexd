# -------------------------------------------------------------------------
# NOUNS
# -------------------------------------------------------------------------

PATTERNS

Nouns_Abs
Nouns_Obl[-o_stem,-u_stem,-human] (([>:>] Inflection[-lat,-human]) | (Inflection[null_morphemes]))
Nouns_Obl[-o_stem,-u_stem,human] (([>:>] Inflection[-lat,-nonhuman]) | (Inflection[null_morphemes]))
(Nouns_Obl[o_stem] | Nouns_Obl[u_stem]) [:uj] [>:>] Inflection[diff_for_o_u]
Nouns_Obl[u_stem,-human] [u:] (([>:>] Inflection[-diff_for_o_u,-lat,-human]) | Inflection[null_morphemes])
Nouns_Obl[o_stem,-human] [o:] (([>:>] Inflection[-diff_for_o_u,-lat,-human]) | Inflection[null_morphemes])
Nouns_Obl[u_stem,human] [u:] (([>:>] Inflection[-diff_for_o_u,-lat,-nonhuman]) | Inflection[null_morphemes])
Nouns_Obl[o_stem,human] [o:] (([>:>] Inflection[-diff_for_o_u,-lat,-nonhuman]) | Inflection[null_morphemes])

LEXICON Inflection

<erg>:v[nonhuman]
<erg>:s[human]
<gen>:ⁿ[diff_for_o_u]
<dat>:n[diff_for_o_u]
<ins>:v
<cont>:x
<lat>:[null_morphemes]
<ad><lat>:gŏ
<inter><lat>:lŏ
<in><lat>:i
<ess>:[null_morphemes]
<ad><ess>:go
<inter><ess>:lo
<in><ess>:i
<abl>:ren
<ad>><abl>:go>ren
<inter>><abl>:lo>ren
<in>><abl>:i>ren
<trans>:ğ
<ad>><trans>:go>ğ
<inter>><trans>:lo>ğ
<in>><trans>:i>ğ
<term>:mciⁿ
<ad>><term>:go>mciⁿ
<inter>><term>:lo>mciⁿ
<in>><term>:i>mciⁿ
<apud><lat>:guiħ
<apud><ess>:ciⁿ
<apud><abl>:xiⁿ

